<Project>
  <Target Name="SetMultiSimPluginBuildDestination"
          AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'EwEMultiSimPlugin'">
        <DestinationSubDirectory>Plugins\MultiSimPlugin\</DestinationSubDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>
  <Target Name="SetMultiSimPluginPublishDestination"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)' == 'EwEMultiSimPlugin'">
        <RelativePath>Plugins\MultiSimPlugin\%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
